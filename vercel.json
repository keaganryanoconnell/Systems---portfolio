{
  "buildCommand": "cd ui-control-center && npm ci && npm run build",
  "outputDirectory": "ui-control-center/out",
  "installCommand": "cd ui-control-center && npm ci",
  "rewrites": [
    { "source": "/capstone", "destination": "/capstone.html" },
    { "source": "/capstone/", "destination": "/capstone.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
